{
    "layout": {
        "type": "layout",
        "pages": [
            "page-tiling",
            "page-floating",
            "page-borders",
            "page-keys",
            "page-about"
        ],
        "page-tiling": {
            "type": "page",
            "title": "Tiling",
            "sections": [
                "sec-gaps",
                "sec-sizes",
                "sec-floatwin",
                "sec-workspaces",
                "sec-feedback"
            ]
        },
        "page-floating": {
            "type": "page",
            "title": "Floating apps",
            "sections": [
                "sec-float-help",
                "sec-float-list"
            ]
        },
        "page-borders": {
            "type": "page",
            "title": "Borders",
            "sections": [
                "sec-borders"
            ]
        },
        "page-keys": {
            "type": "page",
            "title": "Keyboard",
            "sections": [
                "sec-keys-workspaces",
                "sec-keys-modes",
                "sec-keys-direction",
                "sec-keys-resize"
            ]
        },
        "page-about": {
            "type": "page",
            "title": "About",
            "sections": [
                "sec-about"
            ]
        },
        "sec-gaps": {
            "type": "section",
            "title": "Gaps",
            "keys": [
                "innerGap",
                "outerGap"
            ]
        },
        "sec-sizes": {
            "type": "section",
            "title": "Window sizes",
            "keys": [
                "minTileWidth",
                "minTileHeight",
                "floatSizePercent",
                "resizeHelp",
                "resizeStep",
                "resetSizesButton"
            ]
        },
        "sec-floatwin": {
            "type": "section",
            "title": "Floating windows",
            "keys": [
                "floatOnTop"
            ]
        },
        "sec-workspaces": {
            "type": "section",
            "title": "Workspaces",
            "keys": [
                "wsHelp",
                "noTileWorkspaces"
            ]
        },
        "sec-feedback": {
            "type": "section",
            "title": "Feedback",
            "keys": [
                "notify",
                "debug"
            ]
        },
        "sec-borders": {
            "type": "section",
            "title": "Focus and floating borders",
            "keys": [
                "borders",
                "focusColor",
                "floatColor",
                "borderWidth",
                "cornerRadius",
                "cornerEach",
                "radiusTopLeft",
                "radiusTopRight",
                "radiusBottomLeft",
                "radiusBottomRight"
            ]
        },
        "sec-keys-workspaces": {
            "type": "section",
            "title": "Workspace numbers",
            "keys": [
                "superNumWorkspaces",
                "superNumHelp"
            ]
        },
        "sec-keys-modes": {
            "type": "section",
            "title": "Tiling and floating",
            "keys": [
                "keysHelp",
                "keyToggleTiling",
                "keyToggleWorkspace",
                "keyToggleFloat",
                "keyAlwaysFloat",
                "keyPop",
                "keyFullscreen",
                "keyMaximize",
                "keyMonocle",
                "keyToggleSplit",
                "keyPseudo",
                "keyClose",
                "keyRetile",
                "keyCheatSheet"
            ]
        },
        "sec-about": {
            "type": "section",
            "title": "MintyWM",
            "keys": [
                "aboutName",
                "aboutAuthor",
                "aboutWebsite",
                "aboutMastodon"
            ]
        },
        "sec-float-help": {
            "type": "section",
            "title": "How it works",
            "keys": [
                "floatHelp1",
                "floatHelp2",
                "floatHelp3",
                "floatHelp4",
                "floatHelp5"
            ]
        },
        "sec-float-list": {
            "type": "section",
            "title": "Apps that open floating",
            "keys": [
                "floatRules"
            ]
        },
        "sec-keys-resize": {
            "type": "section",
            "title": "Tile sizes",
            "keys": [
                "keyGrowWidth",
                "keyShrinkWidth",
                "keyGrowHeight",
                "keyShrinkHeight",
                "keyResetSizes"
            ]
        },
        "sec-keys-direction": {
            "type": "section",
            "title": "Direction (Hyprland / Omarchy)",
            "keys": [
                "keyFocusLeft",
                "keyFocusRight",
                "keyFocusUp",
                "keyFocusDown",
                "keySwapLeft",
                "keySwapRight",
                "keySwapUp",
                "keySwapDown"
            ]
        }
    },
    "innerGap": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Gap between windows"
    },
    "outerGap": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Gap between windows and the screen or panel edges",
        "tooltip": "The focus border is drawn in this gap, so keep it at least as wide as the border."
    },
    "minTileWidth": {
        "type": "spinbutton",
        "default": 200,
        "min": 0,
        "max": 2000,
        "step": 10,
        "units": "px",
        "description": "Smallest tile width",
        "tooltip": "When more windows are open than fit, the extra ones are parked on screen as floating windows. 0 means no limit."
    },
    "minTileHeight": {
        "type": "spinbutton",
        "default": 120,
        "min": 0,
        "max": 2000,
        "step": 10,
        "units": "px",
        "description": "Smallest tile height",
        "tooltip": "When more windows are open than fit, the extra ones are parked on screen as floating windows. 0 means no limit."
    },
    "floatSizePercent": {
        "type": "spinbutton",
        "default": 60,
        "min": 20,
        "max": 90,
        "step": 5,
        "units": "%",
        "description": "Size of a newly floated window",
        "tooltip": "Used when a window you float has no sensible earlier size. It is centred on its monitor."
    },
    "notify": {
        "type": "switch",
        "default": true,
        "description": "Show a notification when tiling or floating is toggled"
    },
    "debug": {
        "type": "switch",
        "default": false,
        "description": "Log why windows are or aren't tiled (for bug reports)",
        "tooltip": "Writes a line per window to the Cinnamon log after each layout change. You can also run global.mintywm.dump() in Looking Glass (Alt+F2, lg) at any time."
    },
    "borders": {
        "type": "switch",
        "default": true,
        "description": "Draw a border around the focused and floating windows"
    },
    "focusColor": {
        "type": "colorchooser",
        "default": "rgb(0,255,204)",
        "description": "Focused window",
        "dependency": "borders"
    },
    "floatColor": {
        "type": "colorchooser",
        "default": "rgb(255,0,255)",
        "description": "Floating window (not focused)",
        "dependency": "borders"
    },
    "borderWidth": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 6,
        "step": 1,
        "units": "px",
        "description": "Border thickness",
        "dependency": "borders"
    },
    "cornerRadius": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 24,
        "step": 1,
        "units": "px",
        "description": "Window corner radius (all corners)",
        "tooltip": "Match your theme's window corners so the border hugs them. 0 gives square corners.",
        "dependency": "!cornerEach"
    },
    "cornerEach": {
        "type": "switch",
        "default": true,
        "description": "Set each corner separately",
        "tooltip": "Useful for themes with rounded top corners and square bottom corners.",
        "dependency": "borders"
    },
    "radiusTopLeft": {
        "type": "spinbutton",
        "default": 11,
        "min": 0,
        "max": 24,
        "step": 1,
        "units": "px",
        "description": "Top-left corner radius",
        "dependency": "cornerEach"
    },
    "radiusTopRight": {
        "type": "spinbutton",
        "default": 11,
        "min": 0,
        "max": 24,
        "step": 1,
        "units": "px",
        "description": "Top-right corner radius",
        "dependency": "cornerEach"
    },
    "radiusBottomLeft": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 24,
        "step": 1,
        "units": "px",
        "description": "Bottom-left corner radius",
        "dependency": "cornerEach"
    },
    "radiusBottomRight": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 24,
        "step": 1,
        "units": "px",
        "description": "Bottom-right corner radius",
        "dependency": "cornerEach"
    },
    "superNumWorkspaces": {
        "type": "switch",
        "default": false,
        "description": "Super+1 through Super+9 switch workspace",
        "tooltip": "Off by default. Switches to that workspace if it already exists. Does not create one, and does not move the window."
    },
    "superNumHelp": {
        "type": "label",
        "description": "Grouped window list uses Super+1 to Super+9 to focus or minimize the panel button in that slot. Turn that off first: Applets, Grouped window list, General, Hot Keys, then disable \"Enable Super+number shortcut to switch/open apps\". Restart Cinnamon (Alt+F2, r). Use this switch or Cinnamon's own Workspace shortcuts, not both."
    },
    "keyToggleTiling": {
        "type": "keybinding",
        "default": "<Super><Control>t",
        "description": "Pause or resume tiling everywhere"
    },
    "keyToggleFloat": {
        "type": "keybinding",
        "default": "<Super>t",
        "description": "Float or tile the focused window"
    },
    "keyRetile": {
        "type": "keybinding",
        "default": "<Super><Shift>r",
        "description": "Re-tile everything now"
    },
    "aboutName": {
        "type": "label",
        "description": "MintyWM 1.1 RC — dynamic tiling for Cinnamon"
    },
    "aboutAuthor": {
        "type": "label",
        "description": "By Lee Matthew Jackson"
    },
    "aboutWebsite": {
        "type": "label",
        "description": "Website: leematthewjackson.com"
    },
    "aboutMastodon": {
        "type": "label",
        "description": "Mastodon: @leematthewjackson@mastodon.social"
    },
    "floatHelp1": {
        "type": "label",
        "description": "These apps open as floating windows instead of being tiled. Untick a row to stop floating that app, or delete the row."
    },
    "floatHelp2": {
        "type": "label",
        "description": "Easiest way to add an app: click its window and press Super+Shift+T. Press it again to undo."
    },
    "floatHelp3": {
        "type": "label",
        "description": "Or find a window's class yourself: in a terminal run  xprop WM_CLASS  then click the window, and use the first name in quotes."
    },
    "floatHelp4": {
        "type": "label",
        "description": "A * matches anything, so  cinnamon-settings*  covers every Cinnamon Settings window. Capital letters do not matter."
    },
    "floatHelp5": {
        "type": "label",
        "description": "Title contains is optional: leave it empty to float every window of that app. Super+T on one window tiles just that window and leaves this list alone."
    },
    "floatRules": {
        "type": "list",
        "description": "Apps that open floating",
        "columns": [
            {
                "id": "enabled",
                "title": "Float",
                "type": "boolean",
                "default": true
            },
            {
                "id": "wmclass",
                "title": "Window class",
                "type": "string",
                "default": ""
            },
            {
                "id": "title",
                "title": "Title contains (optional)",
                "type": "string",
                "default": ""
            }
        ],
        "default": [
            {
                "enabled": true,
                "wmclass": "cinnamon-settings*",
                "title": ""
            },
            {
                "enabled": true,
                "wmclass": "xlet-settings*",
                "title": ""
            },
            {
                "enabled": true,
                "wmclass": "fontforge*",
                "title": ""
            },
            {
                "enabled": true,
                "wmclass": "gnome-font-viewer*",
                "title": ""
            },
            {
                "enabled": true,
                "wmclass": "copyq*",
                "title": ""
            }
        ]
    },
    "keyAlwaysFloat": {
        "type": "keybinding",
        "default": "<Super><Shift>t",
        "description": "Always float (or stop floating) the focused window's app"
    },
    "floatOnTop": {
        "type": "switch",
        "default": true,
        "description": "Keep floating windows on top of the tiled ones",
        "tooltip": "Only windows MintyWM floats are affected, and only while tiling is on. Windows you pinned on top yourself are left alone."
    },
    "wsHelp": {
        "type": "label",
        "description": "Tiling is never applied on the workspaces listed here. Super+Alt+T flips the workspace you are on and updates this box."
    },
    "noTileWorkspaces": {
        "type": "entry",
        "default": "",
        "description": "Workspaces where tiling is off",
        "tooltip": "Workspace numbers as Cinnamon shows them, for example: 4, 9   or   7-9. Leave empty to tile everywhere."
    },
    "keyToggleWorkspace": {
        "type": "keybinding",
        "default": "<Super><Alt>t",
        "description": "Turn tiling on or off for this workspace"
    },
    "keyResetSizes": {
        "type": "keybinding",
        "default": "<Super><Control>equal",
        "description": "Even tile sizes again on this workspace"
    },
    "resizeHelp": {
        "type": "label",
        "description": "Resize with the keys below, or drag a tile's edge. Split direction stays until you toggle it. Sizes are kept per workspace."
    },
    "resizeStep": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 25,
        "step": 1,
        "units": "%",
        "description": "Resize step",
        "tooltip": "How far one press of the grow or shrink key moves a tile's edge."
    },
    "resetSizesButton": {
        "type": "button",
        "description": "Reset tile sizes on every workspace",
        "callback": "resetSizes"
    },
    "splitRatios": {
        "type": "generic",
        "default": {}
    },
    "keyPop": {
        "type": "keybinding",
        "default": "<Super><Shift>o",
        "description": "Pop the focused window out and pin it"
    },
    "keyFullscreen": {
        "type": "keybinding",
        "default": "<Super>f",
        "description": "Fullscreen"
    },
    "keyMaximize": {
        "type": "keybinding",
        "default": "<Super><Alt>f",
        "description": "Fill the work area (panels stay visible)"
    },
    "keyMonocle": {
        "type": "keybinding",
        "default": "<Super><Control>f",
        "description": "Monocle: one window, gaps kept"
    },
    "keyToggleSplit": {
        "type": "keybinding",
        "default": "<Super>j",
        "description": "Toggle split direction"
    },
    "keyPseudo": {
        "type": "keybinding",
        "default": "<Super><Shift>p",
        "description": "Pseudotile: keep a floating size inside the tile"
    },
    "keyClose": {
        "type": "keybinding",
        "default": "<Super>w",
        "description": "Close the focused window"
    },
    "keyFocusLeft": {
        "type": "keybinding",
        "default": "<Super><Control>Left",
        "description": "Focus the window to the left"
    },
    "keyFocusRight": {
        "type": "keybinding",
        "default": "<Super><Control>Right",
        "description": "Focus the window to the right"
    },
    "keyFocusUp": {
        "type": "keybinding",
        "default": "<Super><Control>Up",
        "description": "Focus the window above"
    },
    "keyFocusDown": {
        "type": "keybinding",
        "default": "<Super><Control>Down",
        "description": "Focus the window below"
    },
    "keySwapLeft": {
        "type": "keybinding",
        "default": "<Super><Control><Shift>Left",
        "description": "Swap with the window to the left"
    },
    "keySwapRight": {
        "type": "keybinding",
        "default": "<Super><Control><Shift>Right",
        "description": "Swap with the window to the right"
    },
    "keySwapUp": {
        "type": "keybinding",
        "default": "<Super><Control><Shift>Up",
        "description": "Swap with the window above"
    },
    "keySwapDown": {
        "type": "keybinding",
        "default": "<Super><Control><Shift>Down",
        "description": "Swap with the window below"
    },
    "keyGrowWidth": {
        "type": "keybinding",
        "default": "<Super>equal",
        "description": "Make the focused tile wider"
    },
    "keyShrinkWidth": {
        "type": "keybinding",
        "default": "<Super>minus",
        "description": "Make the focused tile narrower"
    },
    "keyGrowHeight": {
        "type": "keybinding",
        "default": "<Super><Shift>equal",
        "description": "Make the focused tile taller"
    },
    "keyShrinkHeight": {
        "type": "keybinding",
        "default": "<Super><Shift>minus",
        "description": "Make the focused tile shorter"
    },
    "keyCheatSheet": {
        "type": "keybinding",
        "default": "<Super><Control>slash",
        "description": "Show or hide the key cheat sheet"
    },
    "layoutTrees": {
        "type": "generic",
        "default": {}
    },
    "keysHelp": {
        "type": "label",
        "description": "One set of keys, close to Hyprland and Omarchy. Super+P and Super+O are Cinnamon's (switch monitors, orientation lock), so pseudotile and pop-out are Super+Shift+P and Super+Shift+O. Even sizes is Ctrl+Super+=, because Super+Alt+= zooms the magnifier. Ctrl+Super+arrows move focus so Cinnamon keeps Super+arrow snapping. The cheat sheet is Ctrl+Super+/, because Super+/ often never arrives. The empty box beside a shortcut is an optional second binding, not a missing one. Cinnamon will refuse a shortcut it already uses."
    }
}
